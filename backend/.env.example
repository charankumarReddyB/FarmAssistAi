# FarmAssist AI — Backend Environment Template
# Copy this file to a file named exactly ".env" in the backend/ directory
# All variables below are required for full functionality

# Supabase Project Settings (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Database — Use SQLite for local dev (default) or Supabase Postgres for production
# For local development (SQLite):
DATABASE_URL=sqlite:///./farmassist.db
# For production (Supabase Postgres):
# DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Secret for local auth tokens
SECRET_KEY=farmassist_ai_jwt_secret_key_2026_production

# Admin credentials (seeded on first startup)
ADMIN_EMAIL=admin@farmassist.ai
ADMIN_PASSWORD=Admin@123456

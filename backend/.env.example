# Project Configuration
PROJECT_NAME="FarmAssist AI"
API_V1_STR="/api"
SECRET_KEY="farmassist_secret_key_change_in_production"

# Database Configuration (PostgreSQL with SQLite fallback support)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=farmassist_db
POSTGRES_PORT=5432
# If DATABASE_URL is set, it overrides the PostgreSQL parameters.
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/farmassist_db
# Example SQLite fallback: sqlite:///./farmassist.db
DATABASE_URL=sqlite:///./farmassist.db

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
